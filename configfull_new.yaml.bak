  pure_download_domain:
    type: inline
    behavior: domain
    payload: [release-assets.githubusercontent.com, codeload.github.com, '+.aur.archlinux.org']
  # 已确认使用 CF 的主机；按明确域名维护。
  cloudflare_cdn_domain:
    type: inline
    behavior: domain
    payload:
      - '+.unpkg.com'
      - cdnjs.com
      - api.cdnjs.com
      - nodejs.org
      - linux.do
      - cdn.linux.do
      - connect.linux.do
      - discord.com

