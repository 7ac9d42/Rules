  type: rematch
  target-rematch-name: 日本-机场名称1优先
  target-sub-rule: 分流-探针分类
- name: 日本-机场名称3优先
  type: rematch
  target-rematch-name: 日本-机场名称3优先
  target-sub-rule: 分流-探针分类
- name: 新加坡-机场名称1优先
  type: rematch
  target-rematch-name: 新加坡-机场名称1优先
  target-sub-rule: 分流-探针分类
- name: 新加坡-机场名称3优先
  type: rematch
  target-rematch-name: 新加坡-机场名称3优先
  target-sub-rule: 分流-探针分类
- name: 台湾-机场名称1优先
  type: rematch
  target-rematch-name: 台湾-机场名称1优先
  target-sub-rule: 分流-探针分类
- name: 台湾-机场名称3优先
  type: rematch
  target-rematch-name: 台湾-机场名称3优先
  target-sub-rule: 分流-探针分类
- name: 美国-机场名称1优先
  type: rematch
  target-rematch-name: 美国-机场名称1优先
  target-sub-rule: 分流-探针分类
