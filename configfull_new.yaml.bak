all_airport_providers: &all_airport_providers [Airport_01, Airport_03, Airport_04]

# 订阅：固定 provider 键名；只改 url 及非空、唯一的显示前缀。
proxy-providers:
  Airport_01:
    <<: *proxy_provider_base
    proxy: DIRECT
    url: "订阅链接1"
    override:
      additional-prefix: '[机场名称1]'
      skip-cert-verify: false
  Airport_03:
    <<: *proxy_provider_base
    proxy: DIRECT
    url: "订阅链接3"
    override:
      additional-prefix: '[机场名称3]'
      skip-cert-verify: false
  Airport_04:
    <<: *proxy_provider_base
    proxy: DIRECT
    url: "订阅链接4"
    override:
      additional-prefix: '[机场名称4]'
      skip-cert-verify: false

# 全局配置
global-ua: clash.meta

mode: rule
mixed-port: 7890
ipv6: false
allow-lan: true

# 探测计入首次建连和响应耗时。
unified-delay: false
tcp-concurrent: true
authentication: []
skip-auth-prefixes:
- 127.0.0.1/8
- ::1/128

# LAN 面板：部署时设置自己的密码。
external-controller: 0.0.0.0:9090
secret: "7a13b88333760a18574d3b32"
external-ui: ui
external-ui-url: "https://github.com/Zephyruso/zashboard/archive/refs/heads/gh-pages.zip"

# 无进程规则，关闭进程匹配。
find-process-mode: "off"

profile:
  # 按候选名称保存手选；节点改名后无法原样恢复。
  store-selected: true
  store-fake-ip: true

# 流量嗅探
sniffer:
  enable: true
  force-dns-mapping: true
  parse-pure-ip: true
  override-destination: false
  sniff:
    HTTP:
      ports: [80, 8080, 8888]
      override-destination: true
    TLS:
      ports: [443, 8443, 5228-5230]
    QUIC:
      ports: [443, 8443]
  skip-domain:
    # 忽略米家非 DNS 握手名。
    - "Mijia Cloud"
    - "+.io.mi.com"
    - "+.apple.com"
    - "+.wechat.com"
    - "+.qpic.cn"
    - "+.qq.com"
    - "+.wechatapp.com"
    - "+.vivox.com"
    - "+.oray.com"
    - "+.sunlogin.net"

# TUN
tun:
  enable: true
  stack: system
  device: tun0  # 裸核启动使用；安卓与路由客户端可覆写。macOS 改用 utun 开头。
  mtu: 9000  # TUN MTU；按目标设备验证，不能直接等同物理网卡 MTU。
  dns-hijack:
    - "any:53"
    - "tcp://any:53"
  strict-route: true
  auto-route: true
  auto-redirect: true
  auto-detect-interface: true

# DNS
dns:
  enable: true
  # Android 私人 DNS（DoT）不受 53 端口劫持。
  listen: 0.0.0.0:1053
  ipv6: false
  # 读取 hosts，不调用系统 DNS。
  use-system-hosts: true
  prefer-h3: false
  respect-rules: true
  # LRU 可先返回过期答案，再后台刷新。
  cache-algorithm: lru
  enhanced-mode: fake-ip
  fake-ip-range: 198.18.0.0/15
  fake-ip-range6: fdfe:dcba:9876::/64
  fake-ip-filter-mode: rule
  fake-ip-filter:
    # 保留 Tunnel 的边缘地址池，避免每个区域缩为一个 Fake-IP。
    - "DOMAIN,region1.v2.argotunnel.com,real-ip"
    - "DOMAIN,region2.v2.argotunnel.com,real-ip"

    # 私有域与 STUN
    - "RULE-SET,private_domain,real-ip"

    - "RULE-SET,stun_domain,real-ip"

    # 联网探测与校时
    - "DOMAIN,connectivitycheck.gstatic.com,real-ip"
    - "DOMAIN-SUFFIX,msftconnecttest.com,real-ip"
    - "DOMAIN-SUFFIX,msftncsi.com,real-ip"
    - "DOMAIN-SUFFIX,pool.ntp.org,real-ip"
    - "DOMAIN-SUFFIX,time.windows.com,real-ip"
    - "DOMAIN-SUFFIX,time.apple.com,real-ip"
    - "DOMAIN-SUFFIX,ntp.org.cn,real-ip"

    # 混合过滤集：Real-IP 不代表固定解析器。
    - "RULE-SET,fakeip_filter_domain,real-ip"

    # 游戏、P2P 与特殊服务
    - "DOMAIN-SUFFIX,srv.nintendo.net,real-ip"
    - "DOMAIN-SUFFIX,stun.playstation.net,real-ip"
    - "DOMAIN-SUFFIX,xboxlive.com,real-ip"
    - "DOMAIN-SUFFIX,xbox.microsoft.com,real-ip"
    - "DOMAIN-SUFFIX,sandai.net,real-ip"
    - "DOMAIN-SUFFIX,n0808.com,real-ip"
    - "DOMAIN-SUFFIX,mcdn.bilivideo.cn,real-ip"
    - "DOMAIN-SUFFIX,proxy.golang.org,real-ip"
    - "DOMAIN-SUFFIX,steamserver.net,real-ip"
    # 跨区业务先于国内集合；保留前面的 STUN、探测等 Real-IP 例外。
    - "RULE-SET,google_domain,fake-ip"
    - "RULE-SET,biliintl_domain,fake-ip"
    - "RULE-SET,TVB_domain,fake-ip"
    - "RULE-SET,proxy_domain,fake-ip"
    - "DOMAIN,hk.tv.global.mi.com,fake-ip"

    - "RULE-SET,game_cn_domain,real-ip"
    - "RULE-SET,steam_cn_domain,real-ip"
    - "RULE-SET,pt_domain,real-ip"
    - "RULE-SET,public-tracker_domain,real-ip"
    - "RULE-SET,115_domain,real-ip"

    # 国内业务
    - "RULE-SET,wechat_domain,real-ip"
    - "RULE-SET,bank_cn_domain,real-ip"
    - "RULE-SET,alibaba_domain,real-ip"
    - "RULE-SET,xiaomi_domain,real-ip"
    - "RULE-SET,apple_cn_domain,real-ip"
    - "RULE-SET,ai_cn_domain,real-ip"

    # 国内媒体与总集合
    - "RULE-SET,NetEaseMusic_domain,real-ip"
    - "RULE-SET,media_cn_domain,real-ip"
    - "RULE-SET,iptv_domain,real-ip"
    - "RULE-SET,cn_domain,real-ip"

    - "MATCH,fake-ip"
  default-nameserver:
    # IP 字面量 DoH 仅用于引导，避免外部 53 端口回环。
    # 当前 WRT 直连 1.1.1.1:443 超时，不将其作为引导备用。
    - https://223.5.5.5/dns-query
  proxy-server-nameserver: &dns_direct_servers
    - "https://dns.alidns.com/dns-query#DIRECT"
    - "https://doh.pub/dns-query#DIRECT"
  direct-nameserver: *dns_direct_servers
  # 本地域由上游 MosDNS/本地 DNS 截获，漏入此处返回 NXDOMAIN。
  # 不回退 system/DHCP；plex.direct 使用公开 DNS。
  nameserver-policy:
    "+.argotunnel.com": *dns_direct_servers
    "+.plex.direct": *dns_direct_servers
    "rule-set:private_domain": "rcode://name_error"
    # 与提前匹配的跨区流量规则保持一致，不由国内父域决定解析器。
    "hk.tv.global.mi.com": &dns_remote_servers
      - https://cloudflare-dns.com/dns-query
      - https://dns.google/dns-query
    "rule-set:google_domain,biliintl_domain,TVB_domain,proxy_domain": *dns_remote_servers
    "rule-set:cn_domain": *dns_direct_servers
    # 固定直连的 Real-IP 业务也需在首次查询时指定国内解析器。
    "rule-set:game_cn_domain,steam_cn_domain,pt_domain,public-tracker_domain,115_domain": *dns_direct_servers
    "rule-set:wechat_domain,bank_cn_domain,alibaba_domain,xiaomi_domain,apple_cn_domain,ai_cn_domain": *dns_direct_servers
    "rule-set:NetEaseMusic_domain,media_cn_domain,iptv_domain": *dns_direct_servers
  direct-nameserver-follow-policy: true
  nameserver: *dns_remote_servers

# 机场优先表示固定回退顺序；业务默认值不限制手选范围。
# 各业务独立保存选择；选用家宽/低倍率辅助组时共享该辅助组内部选择。
business_select_base: &business_select_base
  type: select
  use: *all_airport_providers
  # 不在业务层注册额外探针；复用物理池和 provider 的既有健康检查。
  empty-fallback: REJECT

airport_01_policy: &airport_01_policy
  <<: *business_select_base
  proxies:
    - 机场名称1优先
    - 机场名称3优先
    - 香港-机场名称1优先
    - 香港-机场名称3优先
    - 日本-机场名称1优先
    - 日本-机场名称3优先
    - 新加坡-机场名称1优先
    - 新加坡-机场名称3优先
    - 台湾-机场名称1优先
    - 台湾-机场名称3优先
    - 美国-机场名称1优先
    - 美国-机场名称3优先
    - 下载-机场名称1优先
    - 下载-机场名称3优先
    - 自建/家宽节点
    - 低倍率/MITM节点
    - 机场名称1-日本-Google
    - 机场名称1-日本-CF
    - DIRECT

airport_03_policy: &airport_03_policy
  <<: *business_select_base
  proxies:
    - 机场名称3优先
    - 机场名称1优先
    - 香港-机场名称1优先
    - 香港-机场名称3优先
    - 日本-机场名称1优先
    - 日本-机场名称3优先
    - 新加坡-机场名称1优先
    - 新加坡-机场名称3优先
    - 台湾-机场名称1优先
    - 台湾-机场名称3优先
    - 美国-机场名称1优先
    - 美国-机场名称3优先
    - 下载-机场名称1优先
    - 下载-机场名称3优先
    - 自建/家宽节点
    - 低倍率/MITM节点
    - 机场名称1-日本-Google
    - 机场名称1-日本-CF
    - DIRECT

direct_policy: &direct_policy
  <<: *business_select_base
  proxies:
    - DIRECT
    - 机场名称1优先
    - 机场名称3优先
    - 香港-机场名称1优先
    - 香港-机场名称3优先
    - 日本-机场名称1优先
    - 日本-机场名称3优先
    - 新加坡-机场名称1优先
    - 新加坡-机场名称3优先
    - 台湾-机场名称1优先
    - 台湾-机场名称3优先
    - 美国-机场名称1优先
    - 美国-机场名称3优先
    - 下载-机场名称1优先
    - 下载-机场名称3优先
    - 自建/家宽节点
    - 低倍率/MITM节点
    - 机场名称1-日本-Google
    - 机场名称1-日本-CF

# 规则模式普通自动入口共用目标分类；GLOBAL 仅引用可直接拨号的池。
filter_auto_airport_01_tw: &filter_auto_airport_01_tw "(?i)^(?![\\s\\S]*(?:(BETA|wcloud|\\btraffic\\b|(?<![0-9.])(?:0\\.(?=[0-9]*[1-9])(?:[0-2][0-9]*|30*)|(?:[5-9]|[1-9][0-9]+)(?:\\.[0-9]+)?)(?:倍|x)(?![0-9A-Za-z.]))))(?=[\\s\\S]*(?:(台湾|台灣|臺灣|🇹🇼|\\bTW[0-9]*\\b|\\bTWN[0-9]*\\b|Taiwan|Taipei|New ?Taipei|台北|臺北|新北|\\bTPE[0-9]*\\b|Taichung|台中|臺中|\\bRMQ[0-9]*\\b|Tainan|台南|臺南|\\bTNN[0-9]*\\b|Kaohsiung|高雄|\\bKHH[0-9]*\\b)))[\\s\\S]*$"

filter_auto_airport_03_tw: &filter_auto_airport_03_tw "(?i)^(?![\\s\\S]*(?:(BETA|wcloud|\\btraffic\\b|(?<![0-9.])(?:0\\.(?=[0-9]*[1-9])(?:[0-2][0-9]*|30*)|(?:[5-9]|[1-9][0-9]+)(?:\\.[0-9]+)?)(?:倍|x)(?![0-9A-Za-z.]))))(?=[\\s\\S]*(?:(台湾|台灣|臺灣|🇹🇼|\\bTW[0-9]*\\b|\\bTWN[0-9]*\\b|Taiwan|Taipei|New ?Taipei|台北|臺北|新北|\\bTPE[0-9]*\\b|Taichung|台中|臺中|\\bRMQ[0-9]*\\b|Tainan|台南|臺南|\\bTNN[0-9]*\\b|Kaohsiung|高雄|\\bKHH[0-9]*\\b)))[\\s\\S]*$"

# target-rematch-name 只记录入口政策；所有普通入口共用下面同一张目标分类表。
proxies:
- name: 分流-业务入口
  type: rematch
  target-sub-rule: 分流-业务规则
- name: 机场名称1优先
  type: rematch
  target-rematch-name: 机场名称1优先
  target-sub-rule: 分流-探针分类
- name: 机场名称3优先
  type: rematch
  target-rematch-name: 机场名称3优先
  target-sub-rule: 分流-探针分类
- name: 香港-机场名称1优先
  type: rematch
  target-rematch-name: 香港-机场名称1优先
  target-sub-rule: 分流-探针分类
- name: 香港-机场名称3优先
  type: rematch
  target-rematch-name: 香港-机场名称3优先
  target-sub-rule: 分流-探针分类
