  - DIRECT
  hidden: true

rules:
  - NETWORK,tcp,分流-业务入口
  - SUB-RULE,(NETWORK,udp),分流-业务规则
  - NETWORK,udp,REJECT

sub-rules:
  分流-业务规则:
  - RULE-SET,pure_download_domain,纯下载
  - DOMAIN-SUFFIX,opencode.ai,AI
  - DOMAIN,origin-tracker.githubusercontent.com,AI
  - DOMAIN,copilotprodattachments.blob.core.windows.net,AI
  - DOMAIN,hk.tv.global.mi.com,通用代理
  - DOMAIN,ykk.emby.moe,Emby
  - IP-CIDR,189.24.106.132/32,DIRECT,no-resolve
  - DOMAIN-SUFFIX,kuapt.top,DIRECT
  - DOMAIN-SUFFIX,catxxp123.top,DIRECT
  - DOMAIN-SUFFIX,c4lm0n.top,DIRECT
  - DOMAIN-SUFFIX,maj-soul.com,DIRECT
  - DOMAIN-SUFFIX,catmajsoul.com,DIRECT
  - DOMAIN-SUFFIX,catmjstudio.com,DIRECT
  - DOMAIN-SUFFIX,homdgcat.wiki,DIRECT
  - DOMAIN-SUFFIX,bsbsb.top,DIRECT
  - DOMAIN-SUFFIX,3ct.2ndtool.top,DIRECT
  - DOMAIN-SUFFIX,yunmu.xiercloud.uk,DIRECT
  - AND,((DST-PORT,7844),(OR,((DOMAIN,region1.v2.argotunnel.com),(DOMAIN,region2.v2.argotunnel.com),(DOMAIN,cftunnel.com),(DOMAIN,h2.cftunnel.com),(DOMAIN,quic.cftunnel.com)))),Cloudflare Tunnel
  - AND,((DST-PORT,7844),(RULE-SET,cloudflare_tunnel_ip,no-resolve)),Cloudflare Tunnel
  - DOMAIN-SUFFIX,argotunnel.com,DIRECT
  - DOMAIN-SUFFIX,cftunnel.com,DIRECT
  - DOMAIN-SUFFIX,trycloudflare.com,DIRECT
  - RULE-SET,Wise_domain,金融
