# 三机场五探针：统一目标分类、固定地区分向、下载扁平回退。
# 兼容基线 Mihomo v1.19.30；同时验证 v1.19.31，不依赖其独有特性。
# 机场名称1、机场名称3仅同地区测速；先同机场换地区，再跨机场；纯下载地区顺序独立。
# 命名：机场名称x优先=自动入口；地区-机场名称x优先=固定地区入口。
# 物理组追加 Google/CF/GitHub/GitHubRaw/GitHub归档；机场名称x-地区-探针=同区测速。
# 使用说明与旧名称迁移见 README.md。

# 探测与回退
# use 组复用 provider 探测；额外 URL 的周期与超时仍由 provider 决定。
url_test_base: &url_test_base
  type: url-test
  timeout: 5000
  tolerance: 50
  max-failed-times: 3
  empty-fallback: REJECT
  expected-status: 204
  hidden: true

# GitHub 归档 /_ping 返回 200；CF、Google 探针返回 204。
github_archive_url_test_base: &github_archive_url_test_base
  <<: *url_test_base
  url: &github_archive_test_url "https://codeload.github.com/_ping"
  expected-status: 200

cloudflare_url_test_base: &cloudflare_url_test_base
  <<: *url_test_base
  url: &cloudflare_test_url "https://cp.cloudflare.com/generate_204"
  expected-status: 204

# 空池拒绝；全部探测失败仍可能尝试首节点；连接失败可触发复测。
fallback_base: &fallback_base
  type: fallback
  url: &google_test_url "https://www.gstatic.com/generate_204"
  expected-status: 204
  timeout: 5000
  interval: 30
  max-failed-times: 3
  lazy: true
  empty-fallback: REJECT

github_archive_fallback_base: &github_archive_fallback_base
  <<: *fallback_base
  url: *github_archive_test_url
  expected-status: 200
  hidden: true

cloudflare_fallback_base: &cloudflare_fallback_base
  <<: *fallback_base
  url: *cloudflare_test_url
  expected-status: 204
  hidden: true


# 网页与 Raw 独立判断；不将 codeload 健康等同于整个 GitHub 可用。
github_web_url_test_base: &github_web_url_test_base
  <<: *url_test_base
  url: &github_web_test_url "https://github.com/robots.txt"
  expected-status: 200

github_web_fallback_base: &github_web_fallback_base
  <<: *fallback_base
  url: *github_web_test_url
  expected-status: 200
  hidden: true

github_raw_url_test_base: &github_raw_url_test_base
  <<: *url_test_base
  url: &github_raw_test_url "https://raw.githubusercontent.com/MetaCubeX/mihomo/v1.19.30/README.md"
  expected-status: 200

github_raw_fallback_base: &github_raw_fallback_base
  <<: *fallback_base
  url: *github_raw_test_url
  expected-status: 200
  hidden: true

# 机场名称4按地区排序兜底，未知地区排最后。
reserve_region_order: &reserve_region_order "(?i)(香港|港|🇭🇰|\\bHK[0-9]*\\b|Hong ?Kong)`(?i)(日本|🇯🇵|\\bJP[0-9]*\\b|Japan)`(?i)(新加坡|狮城|🇸🇬|\\bSG[0-9]*\\b|Singapore)`(?i)(美国|🇺🇸|🇺🇲|\\bUS[0-9]*\\b|\\bUSA[0-9]*\\b|America|United States|UnitedStates|Los Angeles|Chicago|Ashburn|Seattle|Kansas)`(?i)(台湾|台灣|臺灣|🇹🇼|\\bTW[0-9]*\\b|\\bTWN[0-9]*\\b|Taiwan|Taipei|New ?Taipei|台北|臺北|新北|\\bTPE[0-9]*\\b|Taichung|台中|臺中|\\bRMQ[0-9]*\\b|Tainan|台南|臺南|\\bTNN[0-9]*\\b|Kaohsiung|高雄|\\bKHH[0-9]*\\b)`(?i)(🇦🇱|🇦🇩|🇦🇹|🇧🇾|🇧🇪|🇧🇦|🇧🇬|🇭🇷|🇨🇾|🇨🇿|🇩🇰|🇪🇪|🇫🇮|🇫🇷|🇩🇪|🇬🇷|🇭🇺|🇮🇸|🇮🇪|🇮🇹|🇽🇰|🇱🇻|🇱🇮|🇱🇹|🇱🇺|🇲🇹|🇲🇩|🇲🇨|🇲🇪|🇳🇱|🇲🇰|🇳🇴|🇵🇱|🇵🇹|🇷🇴|🇷🇺|🇸🇲|🇷🇸|🇸🇰|🇸🇮|🇪🇸|🇸🇪|🇨🇭|🇹🇷|🇺🇦|🇬🇧|🇻🇦|欧洲|歐洲|欧盟|歐盟|英国|英國|德国|德國|法国|法國|荷兰|荷蘭|瑞士|瑞典|挪威|芬兰|芬蘭|丹麦|丹麥|意大利|義大利|西班牙|葡萄牙|波兰|波蘭|奥地利|奧地利|爱尔兰|愛爾蘭|比利时|比利時|\\b(?:United ?Kingdom|Britain|England|London|Germany|Frankfurt|Berlin|Munich|France|Paris|Netherlands|Amsterdam|Switzerland|Zurich|Sweden|Stockholm|Norway|Oslo|Finland|Helsinki|Denmark|Copenhagen|Italy|Milan|Rome|Spain|Madrid|Portugal|Lisbon|Poland|Warsaw|Austria|Vienna|Ireland|Dublin|Belgium|Brussels|Romania|Bucharest|Czech(?:ia| Republic)?|Prague|Hungary|Budapest|Greece|Athens|Iceland|Luxembourg|Russia|Moscow|Turkey|Istanbul|Ukraine|Kyiv|Kiev|UK|GB|DE|FR|NL|CH|SE|NO|FI|DK|IT|ES|PT|PL|AT|IE|BE|RO|CZ|HU|GR|IS|LU|RU|TR|UA)\\b)`.*"

# 订阅与规则基础参数
proxy_provider_base: &proxy_provider_base
  type: http
  interval: 86400
  health-check:
    enable: true
    url: *google_test_url
    expected-status: 204
    timeout: 5000
    interval: 60
    lazy: false
  exclude-filter: '(?i)(剩余流量|流量剩余|已用流量|总流量|套餐流量|套餐到期|到期时间|下次重置|重置时间|订阅到期|官方公告|使用教程|Panel[ _-]*Notice|^Expired$|(?:^|[\s\[【(（_|｜丨-])(?:Traffic|Remaining|Quota|Used|Total|Expire(?:d|s)?)\s*[:：]\s*(?:[0-9]|∞|Unlimited)|(?:^|[\s\[【(（_|｜丨-])Email\s*[:：]\s*\S+@|(?:^|[\s\[【(（_|｜丨-])Panel\s*[:：]|(?:^|[\s\[【(（_|｜丨-])(?:官网|客服|工单|邮箱)(?:地址|链接|入口)?(?:$|[\s\]】)）|｜丨:：_-]))'

rule_provider_domain_base: &rule_provider_domain_base
  type: http
  interval: 86400
  behavior: domain
  format: mrs
  proxy: 规则更新

rule_provider_ip_base: &rule_provider_ip_base
  type: http
  interval: 86400
  behavior: ipcidr
  format: mrs
  proxy: 规则更新

rule_provider_classical_base: &rule_provider_classical_base
  type: http
  interval: 86400
  behavior: classical
  format: text
  proxy: 规则更新

# 地区筛选：英文地区码允许紧接数字编号，如 HK01、JP01；不匹配字母子串。
region_hk: &region_hk "(?i)(香港|港|🇭🇰|\\bHK[0-9]*\\b|Hong ?Kong)"

# 香港不稳定编号仅退出自动候选。
region_hk_stable_auto: &region_hk_stable_auto "(?i)^(?!.*Hong ?Kong 0[2-5](?:\\D|$)).*(香港|港|🇭🇰|\\bHK[0-9]*\\b|Hong ?Kong)"
region_sg: &region_sg "(?i)(新加坡|狮城|🇸🇬|\\bSG[0-9]*\\b|Singapore)"
region_jp: &region_jp "(?i)(日本|🇯🇵|\\bJP[0-9]*\\b|Japan)"

# 机场名称3日新排除独立 CTCU 标签（支持空格、连字符、竖线等分隔），保留 CTCUCM。
region_sg_no_ctcu: &region_sg_no_ctcu "(?i)^(?!.*(?<![0-9A-Za-z])CTCU(?![0-9A-Za-z])).*(新加坡|狮城|🇸🇬|\\bSG[0-9]*\\b|Singapore)"
region_jp_no_ctcu: &region_jp_no_ctcu "(?i)^(?!.*(?<![0-9A-Za-z])CTCU(?![0-9A-Za-z])).*(日本|🇯🇵|\\bJP[0-9]*\\b|Japan)"
region_us: &region_us "(?i)(美国|🇺🇸|🇺🇲|\\bUS[0-9]*\\b|\\bUSA[0-9]*\\b|America|United States|UnitedStates|Los Angeles|Chicago|Ashburn|Seattle|Kansas)"
region_download: &region_download "(?i)(香港|港|🇭🇰|\\bHK[0-9]*\\b|Hong ?Kong|日本|🇯🇵|\\bJP[0-9]*\\b|Japan|新加坡|狮城|🇸🇬|\\bSG[0-9]*\\b|Singapore|美国|🇺🇸|🇺🇲|\\bUS[0-9]*\\b|\\bUSA[0-9]*\\b|America|United States|UnitedStates|Los Angeles|Chicago|Ashburn|Seattle|Kansas)"
region_tw: &region_tw "(?i)(台湾|台灣|臺灣|🇹🇼|\\bTW[0-9]*\\b|\\bTWN[0-9]*\\b|Taiwan|Taipei|New ?Taipei|台北|臺北|新北|\\bTPE[0-9]*\\b|Taichung|台中|臺中|\\bRMQ[0-9]*\\b|Tainan|台南|臺南|\\bTNN[0-9]*\\b|Kaohsiung|高雄|\\bKHH[0-9]*\\b)"

# 家宽入口仅认明确标签；CF、运营商名称不能证明出口是家宽。
filter_home: &filter_home "(?i)(自建|家宽|(?<![0-9A-Za-z_])(?:The_house|Self_Back|private|home)(?![0-9A-Za-z_]))"

# Emby：港日新 0<倍率≤0.5 或 MITM；倍率须带 x/倍及数字边界。
filter_lowrate_or_mitm: &filter_lowrate_or_mitm "(?i)(?:(?:香港|港|🇭🇰|\\bHK[0-9]*\\b|Hong ?Kong|日本|🇯🇵|\\bJP[0-9]*\\b|Japan|新加坡|狮城|🇸🇬|\\bSG[0-9]*\\b|Singapore).*(?:(?<![0-9.])0\\.(?=[0-9]*[1-9])(?:[0-4][0-9]*|50*)(?:倍|x)(?![0-9A-Za-z.])|MITM|pornhub)|(?:(?<![0-9.])0\\.(?=[0-9]*[1-9])(?:[0-4][0-9]*|50*)(?:倍|x)(?![0-9A-Za-z.])|MITM|pornhub).*(?:香港|港|🇭🇰|\\bHK[0-9]*\\b|Hong ?Kong|日本|🇯🇵|\\bJP[0-9]*\\b|Japan|新加坡|狮城|🇸🇬|\\bSG[0-9]*\\b|Singapore))"

# 普通自动池排除 ≤0.3x、≥5x 及 BETA。
exclude_standard_auto: &exclude_standard_auto "(?i)(BETA|wcloud|\\btraffic\\b|(?<![0-9.])(?:0\\.(?=[0-9]*[1-9])(?:[0-2][0-9]*|30*)|(?:[5-9]|[1-9][0-9]+)(?:\\.[0-9]+)?)(?:倍|x)(?![0-9A-Za-z.]))"

# 机场名称3美国仅豁免低倍率，不豁免 BETA、高倍率等质量限制。
exclude_airport_03_us: &exclude_airport_03_us "(?i)(BETA|wcloud|\\btraffic\\b|(?<![0-9.])(?:[5-9]|[1-9][0-9]+)(?:\\.[0-9]+)?(?:倍|x)(?![0-9A-Za-z.]))"

# 下载另排除 MITM 等特殊用途；倍率不代表速度。
exclude_download_airport_01: &exclude_download_airport_01 "(?i)(?:BETA|wcloud|MITM|pornhub|\\btraffic\\b|(?<![0-9.])0\\.(?=[0-9]*[1-9])(?:[0-2][0-9]*|30*)(?:倍|x)(?![0-9A-Za-z.])|(?<![0-9.])(?:[5-9]|[1-9][0-9]+)(?:\\.[0-9]+)?(?:倍|x)(?![0-9A-Za-z.])|Hong ?Kong 0[2-5](?:\\D|$))"

# 机场名称3下载仅美国豁免低倍率；日新排除纯 CTCU，保留 CTCUCM。
exclude_download_airport_03: &exclude_download_airport_03 "(?i)(?:BETA|wcloud|MITM|pornhub|\\btraffic\\b|(?<![0-9.])(?:[5-9]|[1-9][0-9]+)(?:\\.[0-9]+)?(?:倍|x)(?![0-9A-Za-z.])|^(?!.*(美国|🇺🇸|🇺🇲|\\bUS[0-9]*\\b|\\bUSA[0-9]*\\b|America|United States|UnitedStates|Los Angeles|Chicago|Ashburn|Seattle|Kansas)).*(?<![0-9.])0\\.(?=[0-9]*[1-9])(?:[0-2][0-9]*|30*)(?:倍|x)(?![0-9A-Za-z.])|^(?=.*(?:(日本|🇯🇵|\\bJP[0-9]*\\b|Japan)|(新加坡|狮城|🇸🇬|\\bSG[0-9]*\\b|Singapore))).*(?<![0-9A-Za-z])CTCU(?![0-9A-Za-z]))"

# 额外探针只接收正向 filter；完整谓词保持原候选范围，同时约束探测范围。
# 同一 provider + URL 按所有引用组的 filter 并集探测；手选台湾/低倍率组仍保留 CF 探针。
# YAML 不拼接正则字符串；调整地区/倍率边界时同步 filter_auto_* / filter_download_* 完整谓词，并运行准入与探针测试。
filter_auto_hk_stable: &filter_auto_hk_stable "(?i)^(?![\\s\\S]*(?:(BETA|wcloud|\\btraffic\\b|(?<![0-9.])(?:0\\.(?=[0-9]*[1-9])(?:[0-2][0-9]*|30*)|(?:[5-9]|[1-9][0-9]+)(?:\\.[0-9]+)?)(?:倍|x)(?![0-9A-Za-z.]))))(?=[\\s\\S]*(?:^(?!.*Hong ?Kong 0[2-5](?:\\D|$)).*(香港|港|🇭🇰|\\bHK[0-9]*\\b|Hong ?Kong)))[\\s\\S]*$"
filter_auto_jp: &filter_auto_jp "(?i)^(?![\\s\\S]*(?:(BETA|wcloud|\\btraffic\\b|(?<![0-9.])(?:0\\.(?=[0-9]*[1-9])(?:[0-2][0-9]*|30*)|(?:[5-9]|[1-9][0-9]+)(?:\\.[0-9]+)?)(?:倍|x)(?![0-9A-Za-z.]))))(?=[\\s\\S]*(?:(日本|🇯🇵|\\bJP[0-9]*\\b|Japan)))[\\s\\S]*$"
filter_auto_sg: &filter_auto_sg "(?i)^(?![\\s\\S]*(?:(BETA|wcloud|\\btraffic\\b|(?<![0-9.])(?:0\\.(?=[0-9]*[1-9])(?:[0-2][0-9]*|30*)|(?:[5-9]|[1-9][0-9]+)(?:\\.[0-9]+)?)(?:倍|x)(?![0-9A-Za-z.]))))(?=[\\s\\S]*(?:(新加坡|狮城|🇸🇬|\\bSG[0-9]*\\b|Singapore)))[\\s\\S]*$"
filter_auto_us: &filter_auto_us "(?i)^(?![\\s\\S]*(?:(BETA|wcloud|\\btraffic\\b|(?<![0-9.])(?:0\\.(?=[0-9]*[1-9])(?:[0-2][0-9]*|30*)|(?:[5-9]|[1-9][0-9]+)(?:\\.[0-9]+)?)(?:倍|x)(?![0-9A-Za-z.]))))(?=[\\s\\S]*(?:(美国|🇺🇸|🇺🇲|\\bUS[0-9]*\\b|\\bUSA[0-9]*\\b|America|United States|UnitedStates|Los Angeles|Chicago|Ashburn|Seattle|Kansas)))[\\s\\S]*$"
filter_auto_hk: &filter_auto_hk "(?i)^(?![\\s\\S]*(?:(BETA|wcloud|\\btraffic\\b|(?<![0-9.])(?:0\\.(?=[0-9]*[1-9])(?:[0-2][0-9]*|30*)|(?:[5-9]|[1-9][0-9]+)(?:\\.[0-9]+)?)(?:倍|x)(?![0-9A-Za-z.]))))(?=[\\s\\S]*(?:(香港|港|🇭🇰|\\bHK[0-9]*\\b|Hong ?Kong)))[\\s\\S]*$"
filter_auto_jp_no_ctcu: &filter_auto_jp_no_ctcu "(?i)^(?![\\s\\S]*(?:(BETA|wcloud|\\btraffic\\b|(?<![0-9.])(?:0\\.(?=[0-9]*[1-9])(?:[0-2][0-9]*|30*)|(?:[5-9]|[1-9][0-9]+)(?:\\.[0-9]+)?)(?:倍|x)(?![0-9A-Za-z.]))))(?=[\\s\\S]*(?:^(?!.*(?<![0-9A-Za-z])CTCU(?![0-9A-Za-z])).*(日本|🇯🇵|\\bJP[0-9]*\\b|Japan)))[\\s\\S]*$"
filter_auto_sg_no_ctcu: &filter_auto_sg_no_ctcu "(?i)^(?![\\s\\S]*(?:(BETA|wcloud|\\btraffic\\b|(?<![0-9.])(?:0\\.(?=[0-9]*[1-9])(?:[0-2][0-9]*|30*)|(?:[5-9]|[1-9][0-9]+)(?:\\.[0-9]+)?)(?:倍|x)(?![0-9A-Za-z.]))))(?=[\\s\\S]*(?:^(?!.*(?<![0-9A-Za-z])CTCU(?![0-9A-Za-z])).*(新加坡|狮城|🇸🇬|\\bSG[0-9]*\\b|Singapore)))[\\s\\S]*$"
filter_auto_airport_03_us: &filter_auto_airport_03_us "(?i)^(?![\\s\\S]*(?:(BETA|wcloud|\\btraffic\\b|(?<![0-9.])(?:[5-9]|[1-9][0-9]+)(?:\\.[0-9]+)?(?:倍|x)(?![0-9A-Za-z.]))))(?=[\\s\\S]*(?:(美国|🇺🇸|🇺🇲|\\bUS[0-9]*\\b|\\bUSA[0-9]*\\b|America|United States|UnitedStates|Los Angeles|Chicago|Ashburn|Seattle|Kansas)))[\\s\\S]*$"
filter_download_airport_03_jp: &filter_download_airport_03_jp "(?i)^(?![\\s\\S]*(?:(?:BETA|wcloud|MITM|pornhub|\\btraffic\\b|(?<![0-9.])(?:[5-9]|[1-9][0-9]+)(?:\\.[0-9]+)?(?:倍|x)(?![0-9A-Za-z.])|^(?!.*(美国|🇺🇸|🇺🇲|\\bUS[0-9]*\\b|\\bUSA[0-9]*\\b|America|United States|UnitedStates|Los Angeles|Chicago|Ashburn|Seattle|Kansas)).*(?<![0-9.])0\\.(?=[0-9]*[1-9])(?:[0-2][0-9]*|30*)(?:倍|x)(?![0-9A-Za-z.])|^(?=.*(?:(日本|🇯🇵|\\bJP[0-9]*\\b|Japan)|(新加坡|狮城|🇸🇬|\\bSG[0-9]*\\b|Singapore))).*(?<![0-9A-Za-z])CTCU(?![0-9A-Za-z]))))(?=[\\s\\S]*(?:(日本|🇯🇵|\\bJP[0-9]*\\b|Japan)))[\\s\\S]*$"
filter_download_airport_03_sg: &filter_download_airport_03_sg "(?i)^(?![\\s\\S]*(?:(?:BETA|wcloud|MITM|pornhub|\\btraffic\\b|(?<![0-9.])(?:[5-9]|[1-9][0-9]+)(?:\\.[0-9]+)?(?:倍|x)(?![0-9A-Za-z.])|^(?!.*(美国|🇺🇸|🇺🇲|\\bUS[0-9]*\\b|\\bUSA[0-9]*\\b|America|United States|UnitedStates|Los Angeles|Chicago|Ashburn|Seattle|Kansas)).*(?<![0-9.])0\\.(?=[0-9]*[1-9])(?:[0-2][0-9]*|30*)(?:倍|x)(?![0-9A-Za-z.])|^(?=.*(?:(日本|🇯🇵|\\bJP[0-9]*\\b|Japan)|(新加坡|狮城|🇸🇬|\\bSG[0-9]*\\b|Singapore))).*(?<![0-9A-Za-z])CTCU(?![0-9A-Za-z]))))(?=[\\s\\S]*(?:(新加坡|狮城|🇸🇬|\\bSG[0-9]*\\b|Singapore)))[\\s\\S]*$"
filter_download_airport_03_us: &filter_download_airport_03_us "(?i)^(?![\\s\\S]*(?:(?:BETA|wcloud|MITM|pornhub|\\btraffic\\b|(?<![0-9.])(?:[5-9]|[1-9][0-9]+)(?:\\.[0-9]+)?(?:倍|x)(?![0-9A-Za-z.])|^(?!.*(美国|🇺🇸|🇺🇲|\\bUS[0-9]*\\b|\\bUSA[0-9]*\\b|America|United States|UnitedStates|Los Angeles|Chicago|Ashburn|Seattle|Kansas)).*(?<![0-9.])0\\.(?=[0-9]*[1-9])(?:[0-2][0-9]*|30*)(?:倍|x)(?![0-9A-Za-z.])|^(?=.*(?:(日本|🇯🇵|\\bJP[0-9]*\\b|Japan)|(新加坡|狮城|🇸🇬|\\bSG[0-9]*\\b|Singapore))).*(?<![0-9A-Za-z])CTCU(?![0-9A-Za-z]))))(?=[\\s\\S]*(?:(美国|🇺🇸|🇺🇲|\\bUS[0-9]*\\b|\\bUSA[0-9]*\\b|America|United States|UnitedStates|Los Angeles|Chicago|Ashburn|Seattle|Kansas)))[\\s\\S]*$"
