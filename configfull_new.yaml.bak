  # Cloudflare 官方网段；仅供代理入口内目标分类，不覆盖业务直连规则。
  cloudflare_cdn_ipv4:
    type: http
    behavior: ipcidr
    format: text
    interval: 86400
    url: https://www.cloudflare.com/ips-v4
    proxy: 机场名称1优先-CF

